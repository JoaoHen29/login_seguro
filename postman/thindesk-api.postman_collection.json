      "name": "G - Indicadores do dashboard",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna 200 OK\", () => pm.response.to.have.status(200));\r\nconst dados = pm.response.json();\r\npm.test(\"Traz os indicadores gerais do período\", () => {\r\n    pm.expect(dados).to.include.keys(\"totalChamados\", \"pendentes\", \"resolvidos\", \"taxaResolucao\", \"percentualForaDoPrazo\", \"tempoMedioResolucaoHoras\");\r\n    pm.expect(dados.totalChamados).to.be.above(0);\r\n});"
            ]
          }
        }
      ],
