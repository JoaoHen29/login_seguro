    {
      "name": "I - Tipos mais atendidos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna 200 OK\", () => pm.response.to.have.status(200));\r\nconst tipos = pm.response.json();\r\npm.test(\"Respeita o limite de 3 tipos\", () => pm.expect(tipos.length).to.be.at.most(3));\r\npm.test(\"Ordena do mais atendido para o menos atendido\", () => {\r\n    for (let i = 1; i < tipos.length; i++) {\r\n        pm.expect(tipos[i - 1].total).to.be.at.least(tipos[i].total);\r\n    }\r\n});"
            ]
          }
        }
      ],
      "request": {
