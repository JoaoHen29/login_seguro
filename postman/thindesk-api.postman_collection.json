  "item": [
    {
      "name": "A - Abrir chamado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna 201 Created\", () => pm.response.to.have.status(201));\r\nconst corpo = pm.response.json();\r\npm.test(\"Gera protocolo no formato TD-000000 com status ABERTO\", () => {\r\n    pm.expect(corpo.chamado.protocolo).to.match(/^TD-\\d{6}$/);\r\n    pm.expect(corpo.chamado.status).to.eql(\"ABERTO\");\r\n});\r\npm.test(\"Informa o endereço do novo chamado no header Location\", () => {\r\n    pm.response.to.have.header(\"Location\");\r\n});\r\npm.environment.set(\"protocolo\", corpo.chamado.protocolo);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"titulo\": \"Computador do caixa não liga\",\r\n  \"descricao\": \"O computador do caixa 2 não liga desde a manhã. A luz da fonte não acende.\",\r\n  \"tipo\": \"HARDWARE\",\r\n  \"prioridade\": \"ALTA\",\r\n  \"solicitante\": \"João Henrique\",\r\n  \"setor\": \"Financeiro\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/chamados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chamados"
          ]
        }
      },
      "response": []
    },
