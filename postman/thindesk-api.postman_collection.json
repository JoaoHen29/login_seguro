    {
      "name": "H - Atendimentos por mês",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna 200 OK\", () => pm.response.to.have.status(200));\r\nconst serie = pm.response.json();\r\npm.test(\"Agrupa os pontos por mês\", () => pm.expect(serie.agrupamento).to.eql(\"MES\"));\r\npm.test(\"Soma dos pontos bate com o total de abertos\", () => {\r\n    const soma = serie.pontos.reduce((total, ponto) => total + ponto.abertos, 0);\r\n    pm.expect(soma).to.eql(serie.totalAbertos);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
