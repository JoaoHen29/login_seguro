    {
      "name": "B - Iniciar atendimento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna 200 OK\", () => pm.response.to.have.status(200));\r\npm.test(\"Chamado passa para EM_ATENDIMENTO com técnico\", () => {\r\n    const chamado = pm.response.json().chamado;\r\n    pm.expect(chamado.status).to.eql(\"EM_ATENDIMENTO\");\r\n    pm.expect(chamado.tecnicoResponsavel).to.eql(\"Ana Ribeiro\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"status\": \"EM_ATENDIMENTO\",\r\n  \"consideracao\": \"Verificando a fonte de alimentação.\",\r\n  \"tecnicoResponsavel\": \"Ana Ribeiro\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/chamados/{{protocolo}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chamados",
            "{{protocolo}}",
            "status"
          ]
        }
      },
      "response": []
    },
    {
      "name": "C - Resolver chamado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna 200 OK\", () => pm.response.to.have.status(200));\r\nconst corpo = pm.response.json();\r\npm.test(\"Chamado fica RESOLVIDO com data de encerramento\", () => {\r\n    pm.expect(corpo.chamado.status).to.eql(\"RESOLVIDO\");\r\n    pm.expect(corpo.chamado.encerradoEm).to.not.be.null;\r\n});\r\npm.test(\"Histórico guarda as 3 considerações técnicas\", () => {\r\n    pm.expect(corpo.historico).to.have.lengthOf(3);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"status\": \"RESOLVIDO\",\r\n  \"consideracao\": \"Fonte queimada substituída. Equipamento testado e funcionando.\"\r\n}",
          "options": {
